# ─────────────────────────────────────────────────────────────
# RedFlag.GG — environment
#
# Copy to `.env.local` and fill in. Never commit real values;
# `.env*.local` is gitignored.
#
# The authoritative contract is lib/env.ts (server) and
# lib/public-env.ts (browser). If you add a variable there, add it
# here in the same commit.
# ─────────────────────────────────────────────────────────────

# ── App ─────────────────────────────────────────────────────
# Does more than build links: `upgrade-insecure-requests` and HSTS are
# emitted ONLY when this starts with `https://`. Keep it http:// locally,
# or WebKit will rewrite every asset to https://localhost and the page
# will load with no CSS. See next.config.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ────────────────────────────────────────────────
# Dashboard → Project Settings → API
# All three are REQUIRED; the app throws a named error on boot without them.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Note: verification is magic-link only, so there is nothing to configure here.
# The stock Supabase email template works as-is. `/auth/confirm` handles the
# clicked link for both a new sign-in and an anonymous→verified upgrade.

# ── AI verdict engine ───────────────────────────────────────
# Groq is primary (llama-3.3-70b-versatile), NVIDIA NIM is the fallback.
# Both are optional to boot, but with neither set every case ends in a
# canned "split verdict" instead of a real ruling.
GROQ_API_KEY=gsk_...
# OpenAI-compatible endpoint. Get a key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-...

# ── Rate limiting (Upstash Redis) ───────────────────────────
# REQUIRED in production: write limiters FAIL CLOSED, so with these unset every
# vote and filing is rejected in prod. Locally they log a warning and allow the
# write, so set them if you want to exercise real throttling behaviour.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Vote fingerprinting ─────────────────────────────────────
# REQUIRED. HMAC salt for anonymous-vote device fingerprints, which is what stops
# someone clearing storage to vote twice. Rotating it resets anonymous dedupe
# (existing votes survive). No raw IP is ever stored — this keys a one-way hash.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VOTE_FP_SALT=

# ── Cron ────────────────────────────────────────────────────
# Bearer token for /api/cron/gavel, compared with timingSafeEqual.
# The route FAILS CLOSED when this is unset — an unauthenticated endpoint that
# triggers LLM spend is not something to leave open by default.
# Vercel injects this automatically for its own cron invocations.
CRON_SECRET=

# ── Cashfree (RedFlag Pro subscription) ─────────────────────
# Merchant Dashboard → Developers → API Keys.
# Only read on billing paths, so the app runs without them — the first
# subscribe attempt is what throws.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# 'sandbox' or 'production'. These two MUST match: the server picks its API host
# from the first, the browser SDK picks its host from the second.
CASHFREE_ENV=sandbox
NEXT_PUBLIC_CASHFREE_ENV=sandbox

# ── Tests (optional) ────────────────────────────────────────
# Point the Playwright suite at a deployed URL instead of localhost:3000.
# PLAYWRIGHT_BASE_URL=

# ─────────────────────────────────────────────────────────────
# NOT an environment variable: admin access.
#
# Admin is `profiles.is_admin`, a database flag:
#   update public.profiles set is_admin = true where handle = 'your_handle';
#
# The old ADMIN_USER_IDS allowlist was removed because granting admin required a
# redeploy, and an env list could disagree with the database about who is an
# admin — the worst kind of ambiguity for a privileged check.
# ─────────────────────────────────────────────────────────────
