# ─────────────────────────────────────────────────────────────
# RedFlag.GG — environment
# Copy to `.env.local` and fill in. Never commit real values.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI verdict engine ───────────────────────────────────────
# Primary provider
GROQ_API_KEY=your-groq-key
# Fallback provider
GEMINI_API_KEY=your-gemini-key

# ── Rate limiting (Upstash Redis) ───────────────────────────
# Required in production. Absent locally = limiters fail CLOSED on
# write paths, so set these to exercise real behaviour.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Vote fingerprinting ─────────────────────────────────────
# HMAC salt for anonymous-vote device fingerprints. Must be a long
# random string. Rotating it resets anonymous dedupe (votes survive).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VOTE_FP_SALT=

# ── Cron ────────────────────────────────────────────────────
# Bearer token for /api/cron/gavel. Route FAILS CLOSED if unset.
CRON_SECRET=

# ── Stripe (RedFlag+ subscription) ──────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PLUS_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Admin ───────────────────────────────────────────────────
# Comma-separated Supabase user UUIDs allowed into /admin/docket
ADMIN_USER_IDS=
